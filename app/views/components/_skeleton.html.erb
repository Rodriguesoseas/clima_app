<%#
  Skeleton de carregamento — usado dentro de <template> e clonado via JS durante o fetch.
%>
<div class="col-span-1 grid grid-cols-1 gap-6 md:col-span-12 md:grid-cols-12 md:gap-8" aria-hidden="true">
  <div class="glass col-span-1 p-8 md:col-span-8 md:p-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="w-2/3 space-y-3">
        <div class="skeleton h-3 w-24"></div>
        <div class="skeleton h-8 w-48"></div>
        <div class="skeleton h-4 w-64"></div>
      </div>
      <div class="flex items-center gap-6">
        <div class="skeleton h-20 w-28"></div>
        <div class="skeleton h-16 w-16 rounded-full"></div>
      </div>
    </div>
  </div>

  <div class="col-span-1 grid grid-cols-2 content-start gap-4 md:col-span-4">
    <% 4.times do %>
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.03] p-4">
        <div class="skeleton h-4 w-16"></div>
        <div class="mt-3 skeleton h-6 w-20"></div>
      </div>
    <% end %>
  </div>

  <div class="glass col-span-1 p-6 md:col-span-12 md:p-8">
    <div class="skeleton mb-6 h-4 w-36"></div>
    <div class="flex gap-3 overflow-hidden">
      <% 8.times do %>
        <div class="skeleton h-24 w-[76px] shrink-0 rounded-2xl"></div>
      <% end %>
    </div>
  </div>

  <div class="glass col-span-1 p-6 md:col-span-12 md:p-8">
    <div class="skeleton mb-6 h-4 w-36"></div>
    <div class="space-y-3.5">
      <% 5.times do %>
        <div class="skeleton h-5 w-full rounded-full"></div>
      <% end %>
    </div>
  </div>
</div>
