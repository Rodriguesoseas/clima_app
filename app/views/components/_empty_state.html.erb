<div class="glass col-span-1 flex flex-col items-center justify-center gap-6 py-20 text-center md:col-span-12">
  <div class="relative">
    <div class="absolute inset-0 scale-150 rounded-full bg-blue-500/15 blur-2xl" aria-hidden="true"></div>
    <span class="relative block text-slate-500">
      <%= icone_weather(:sol_nuvem, class: "h-14 w-14") %>
    </span>
  </div>
  <div class="max-w-sm space-y-1.5">
    <h2 class="text-lg font-semibold text-slate-200">Descubra o clima da sua cidade</h2>
    <p class="text-sm text-slate-500">
      Digite o nome de uma cidade acima ou toque em uma das populares.
    </p>
  </div>
</div>
