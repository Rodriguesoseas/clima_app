<header data-scroll-nav class="glass-nav sticky top-0 z-50">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:px-8">
    <%= link_to root_path, class: "group flex items-center gap-2.5" do %>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-600 shadow-glow transition-transform duration-200 ease-out-expo group-hover:scale-105">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
        </svg>
      </span>
      <span class="text-lg font-bold tracking-tight text-white">Clima<span class="font-medium text-slate-500">App</span></span>
    <% end %>

    <nav class="flex items-center gap-2">
      <% if logged_in? %>
        <div class="relative" data-dropdown>
          <button
            type="button"
            data-dropdown-button
            class="flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] py-1 pl-1 pr-2.5 transition-all duration-200 hover:bg-white/10"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Menu da conta"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-sm font-bold text-white">
              <%= current_user.email.first.upcase %>
            </span>
            <span class="hidden max-w-[160px] truncate text-sm text-slate-300 sm:block"><%= current_user.email %></span>
            <svg data-dropdown-chevron class="h-4 w-4 text-slate-500 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>

          <div data-dropdown-menu hidden class="absolute right-0 top-full mt-2 w-60 origin-top-right animate-fade-up rounded-2xl border border-white/10 bg-slate-900/90 p-2 shadow-lift backdrop-blur-xl" role="menu">
            <p class="px-3 pt-2 text-[11px] font-medium uppercase tracking-wider text-slate-500">conectado como</p>
            <p class="truncate px-3 pb-2 pt-1 text-sm text-slate-200"><%= current_user.email %></p>
            <div class="my-1 h-px bg-white/10"></div>
            <%= button_to logout_path, method: :delete, role: "menuitem", class: "flex w-full items-center gap-2 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-red-300 transition-colors duration-200 hover:bg-red-500/10" do %>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <path d="m16 17 5-5-5-5M21 12H9" />
              </svg>
              Sair
            <% end %>
          </div>
        </div>
      <% else %>
        <%= link_to "Entrar", login_path, class: "btn-ghost" %>
        <%= link_to "Cadastrar", signup_path, class: "btn-primary px-4 py-2" %>
      <% end %>
    </nav>
  </div>
</header>
